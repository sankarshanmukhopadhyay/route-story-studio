{
  "name": "route-story-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first GPX route visualisation and story export studio.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-project.mjs",
    "build": "node scripts/build.mjs",
    "validate": "npm run check && npm run security-check && npm run docs-check && npm test && npm run build",
    "security-check": "node scripts/security-check.mjs",
    "site-smoke": "node scripts/site-smoke.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "release-check": "npm run validate && npm run site-smoke",
    "docs-check": "node scripts/docs-check.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "axe-core": "4.12.1"
  }
}
